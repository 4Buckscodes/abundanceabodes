# --- AI Listing Assistant (server-side only) ---------------------------------
# Groq API key. When unset, the AI Listing Assistant silently falls back to the
# deterministic extraction engine — the admin never loses their input. This is a
# SERVER secret: it is read only in server actions/provider code (guarded by a
# `typeof window` check) and must never be prefixed with NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional. Overrides the default Groq model. Defaults to qwen/qwen3.8-27b.
# GROQ_MODEL=qwen/qwen3.8-27b

# --- Supabase ----------------------------------------------------------------
# PUBLIC (browser-safe) credentials. When unset, the app serves seed data.
# Uses Supabase's new API-key system: the publishable key (sb_publishable_...)
# replaces the legacy anon key. Safe to expose to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback (deprecated). Only needed during migration; prefer the
# publishable key above. Remove once the publishable key is in place.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY privileged key for admin writes, the enquiry inbox and image
# uploads. This is the new secret key (sb_secret_...) — it bypasses RLS, so it
# must NEVER be exposed to the browser and must NEVER be prefixed with
# NEXT_PUBLIC_. It is read only behind a `typeof window` server guard.
SUPABASE_SECRET_KEY=
# Legacy fallback (deprecated). Only read if SUPABASE_SECRET_KEY is unset.
# Remove once the secret key is in place.
# SUPABASE_SERVICE_ROLE_KEY=
